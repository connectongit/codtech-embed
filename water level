/*
 * Project: Water Level Indicator & Automatic Pump Controller
 * Description: Non-contact ultrasonic water tank monitor with LED bar, overflow alarm, and relay pump control
 * Hardware: Arduino Uno, HC-SR04 Ultrasonic Sensor, 4x LEDs, 4x 220-ohm Resistors, Buzzer, 5V Relay Module
 */

// Ultrasonic Sensor Pins
const int TRIG_PIN = 9;
const int ECHO_PIN = 10;

// Level Indicator LEDs
const int LED_25  = 2; // Red    (Low)
const int LED_50  = 3; // Yellow (Medium)
const int LED_75  = 4; // Blue   (High)
const int LED_100 = 5; // Green  (Full)

// Buzzer and Pump Relay Pins
const int BUZZER_PIN = 6;
const int RELAY_PIN  = 7;

// Tank Calibration Constants (in centimeters)
const float TANK_DEPTH_CM     = 100.0; // Distance from sensor to empty tank bottom
const float SENSOR_OFFSET_CM  = 10.0;  // Safe gap between sensor and maximum water surface

bool pumpState = false;

float measureDistanceCM() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return TANK_DEPTH_CM;
  return (duration * 0.0343) / 2.0;
}

void setup() {
  Serial.begin(9600);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  pinMode(LED_25, OUTPUT);
  pinMode(LED_50, OUTPUT);
  pinMode(LED_75, OUTPUT);
  pinMode(LED_100, OUTPUT);

  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW); // Start with pump OFF

  Serial.println("Water Level Indicator System Started...");
}

void loop() {
  float distance = measureDistanceCM();

  // Calculate fill percentage (constrained between 0% and 100%)
  float usableHeight = TANK_DEPTH_CM - SENSOR_OFFSET_CM;
  float waterHeight  = TANK_DEPTH_CM - distance;
  int levelPercent   = constrain((int)((waterHeight / usableHeight) * 100.0), 0, 100);

  // Update LED Level Indicators
  digitalWrite(LED_25,  levelPercent >= 20 ? HIGH : LOW);
  digitalWrite(LED_50,  levelPercent >= 50 ? HIGH : LOW);
  digitalWrite(LED_75,  levelPercent >= 75 ? HIGH : LOW);
  digitalWrite(LED_100, levelPercent >= 90 ? HIGH : LOW);

  // Hysteresis Pump Control (Turn ON below 25%, Turn OFF at or above 90%)
  if (levelPercent <= 25 && !pumpState) {
    pumpState = true;
    digitalWrite(RELAY_PIN, HIGH);
    Serial.println("Status: Tank Low -> Water Pump TURNED ON");
  } else if (levelPercent >= 90 && pumpState) {
    pumpState = false;
    digitalWrite(RELAY_PIN, LOW);
    Serial.println("Status: Tank Full -> Water Pump TURNED OFF");
  }

  // Overflow Warning Alarm (>= 95%)
  if (levelPercent >= 95) {
    tone(BUZZER_PIN, 1500, 300);
  } else {
    noTone(BUZZER_PIN);
  }

  // Serial Monitor Telemetry
  Serial.print("Distance: "); Serial.print(distance, 1); Serial.print(" cm | ");
  Serial.print("Water Level: "); Serial.print(levelPercent); Serial.print("% | ");
  Serial.print("Pump: "); Serial.println(pumpState ? "ON" : "OFF");

  delay(1000);
}
